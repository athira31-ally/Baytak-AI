# Copy to .env. Everything is optional: with nothing set, the app runs fully offline.

# --- Azure OpenAI: turns on the LLM agent (function calling) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=                 # leave empty to use Entra ID / Managed Identity
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=chat
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# local | azure. Change requires re-running: python -m scripts.bootstrap
EMBEDDING_PROVIDER=local

# --- Azure AI Search: hybrid (BM25 + vector) retrieval. Needs EMBEDDING_PROVIDER=azure ---
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=dubai-listings

# --- Azure Cosmos DB (serverless): feedback events, A/B + bandit state ---
COSMOS_ENDPOINT=
COSMOS_KEY=

# --- Application Insights: traces, latency, agent tool usage ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Recommender ---
AB_RANKER_SHARE=0.8
TOP_K=10

# --- Live Dubai Land Department data (optional) ---
# Register at dubaipulse.gov.ae and request dld_transactions-open-api (+ dld_rent_contracts-open-api).
# With these set, the app fetches the latest 12 months daily and refreshes itself - no downloads.
DUBAI_PULSE_API_KEY=
DUBAI_PULSE_API_SECRET=
# DUBAI_PULSE_SALES_URL=https://api.dubaipulse.gov.ae/open/dld/dld_transactions-open-api
# DUBAI_PULSE_RENTS_URL=https://api.dubaipulse.gov.ae/open/dld/dld_rent_contracts-open-api

# --- Market Data Agent (daily cron) ---
# Cosmos DB above holds the deals (market_tx) and the agent's memory (agent_memory).
# Redis caches the published homes + search results. Empty = in-process cache.
REDIS_URL=
# Optional: fixed data.dubai CSV links (comma-separated) if auto-discovery is blocked
DLD_FILE_URLS=
HOMES_SYNC_SECONDS=300

# --- Microsoft Foundry Agent Service (optional): run the Market Data Agent as a Foundry agent ---
# Created by infra/deploy_foundry.sh. Uses your `az login` identity locally (no key).
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=gpt-5-mini
